<?xml version='1.0'?>
<Obfuscator>
  <Var name="InPath" value="." />
  <Var name="OutPath" value="./Obfuscated" />
  <Var name="KeepPublicApi" value="false" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameFields" value="true" />
  <Var name="RenameProperties" value="true" />
  <Var name="RenameEvents" value="true" />
  <Var name="RenameTypes" value="true" />
  <Var name="RenameNamespaces" value="true" />
  <Var name="OptimizeMethods" value="true" />
  <Var name="SuppressIldasm" value="true" />
  <Var name="UseUnicodeNames" value="true" />
  <Var name="RegenerateDebugInfo" value="false" />
  <Var name="MarkedOnly" value="false" />

  <Module file="$(InPath)/PrivacyWarden.dll">
    <!-- Keep entry point and hosted service names so .NET DI can resolve them -->
    <SkipType name="PrivacyWarden.Program" />
    <SkipType name="PrivacyWarden.Worker" />
    <SkipMethod type="PrivacyWarden.Program" name="Main" />

    <!-- Keep Windows Service infrastructure names -->
    <SkipType name="PrivacyWarden.Services.SystemTrayService" />

    <!-- Keep config model so JSON deserialization works -->
    <SkipType name="PrivacyWarden.Models.VTuberConfig" />
    <SkipProperty type="PrivacyWarden.Models.VTuberConfig" name="*" />
  </Module>
</Obfuscator>
