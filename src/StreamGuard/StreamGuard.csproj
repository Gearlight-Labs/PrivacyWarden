<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      Framework-dependent build: requires .NET 8 runtime.
      Windows 10/11 ships .NET 8 via Windows Update, so users already have it.
      This keeps StreamGuard.exe at ~5-8 MB instead of ~80-120 MB (self-contained).
      If a user doesn't have .NET 8, Windows will prompt them to install it automatically.
    -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>

    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>tray_icon.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>StreamGuard</AssemblyName>
    <RootNamespace>StreamGuard</RootNamespace>
    <Description>StreamGuard — auto-toggles Mullvad VPN and enforces DNS lock for VTubers. Created by Aya Yoki (AyaYokiVT) — Gearlight Labs.</Description>
    <Version>1.1.1</Version>
    <Authors>Aya Yoki (AyaYokiVT)</Authors>
    <Company>Gearlight Labs</Company>
    <Copyright>© 2026 Aya Yoki (AyaYokiVT) — Gearlight Labs. Private Use Only.</Copyright>
    <PackageProjectUrl>https://github.com/Gearlight-Labs/StreamGuard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Gearlight-Labs/StreamGuard</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="tray_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
